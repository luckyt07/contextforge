# ========================================================
# RAG Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ========================================================

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DB_URL=postgresql+psycopg://postgres:your_postgres_password@localhost:5432/rag_db

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant Vector Store ---
QDRANT_URL=http://localhost:6333

# --- MLflow Tracking Server ---
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=02-localhost-app
PROMPT_ALIAS=production

# --- LLM Providers ---
# Groq (Cloud LLM - Recommended)
GROQ_API_KEY=your_groq_api_key_here

# Local LLM / vLLM (Optional)
LLM_BASE_URL=http://localhost:8002/v1
EMBEDDING_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
